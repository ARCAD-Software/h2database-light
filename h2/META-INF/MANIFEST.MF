 javax.net.ssl,
 javax.script;resolution:=optional,
 javax.security.auth.callback,
 javax.security.auth.login,
 javax.servlet;resolution:=optional,
 javax.servlet.http;resolution:=optional,
 javax.sql,
 javax.tools;resolution:=optional,
 javax.transaction.xa;resolution:=optional,
 javax.xml.parsers;resolution:=optional,
 javax.xml.stream;resolution:=optional,
 javax.xml.transform;resolution:=optional,
 javax.xml.transform.dom;resolution:=optional,
 javax.xml.transform.sax;resolution:=optional,
 javax.xml.transform.stax;resolution:=optional,
 javax.xml.transform.stream;resolution:=optional,
 org.locationtech.jts.geom;version="1.15.0";resolution:=optional,
 org.locationtech.jts.geom.impl;version="1.15.0";resolution:=optional,
 org.locationtech.jts.io;version="1.15.0";resolution:=optional,
 org.osgi.framework;version="1.5",
 org.osgi.service.jdbc;version="1.0";resolution:=optional,
 org.slf4j;version="[1.6.0,1.7.0)",
 org.w3c.dom,
 org.xml.sax,
 org.xml.sax.helpers
Export-Package: org.h2;version="1.4.200",
 org.h2.api;version="1.4.200",
 org.h2.fulltext;version="1.4.200",
 org.h2.jdbc;version="1.4.200",
